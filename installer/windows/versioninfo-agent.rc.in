1 24 "@AGENT_MANIFEST@"

1 VERSIONINFO
FILEVERSION @FILE_VERSION_COMMAS@
PRODUCTVERSION @FILE_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x00040004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Ace IT Center\0"
      VALUE "FileDescription", "Ace IT Center Agent\0"
      VALUE "FileVersion", "@FILE_VERSION_DOTS@\0"
      VALUE "InternalName", "AceAgent\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 Ace IT Center\0"
      VALUE "OriginalFilename", "AceAgent.exe\0"
      VALUE "ProductName", "Ace IT Center Agent\0"
      VALUE "ProductVersion", "@PRODUCT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
